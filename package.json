{
  "name": "rcm-texassolutions",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Texas Solutions RCM (rcm.texassolutions.co): custom WordPress theme and RCM Core plugin, with the content sources and build tooling",
  "scripts": {
    "build": "node build/build.mjs",
    "build:content": "node build/export-content.mjs",
    "build:js": "node build/build-js.mjs",
    "build:css": "tailwindcss -c build/tailwind.config.cjs -i build/theme.css -o wordpress/rcm-theme/assets/css/site.css --minify",
    "package": "node build/build.mjs && python build/package.py",
    "dev": "node build/dev.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource-variable/plus-jakarta-sans": "^5.2.5",
    "@types/node": "22.10.5",
    "@wp-playground/cli": "3.1.55",
    "esbuild": "0.28.2",
    "lucide-static": "^0.469.0",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3",
    "vitest": "3.2.4"
  }
}
